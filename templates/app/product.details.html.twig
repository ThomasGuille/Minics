{% extends 'base.html.twig' %}

{% block title %}Minics | Details produit{% endblock %}

{% block body %}
    {# {{ dump(product) }} #}
    <div class="container">
        <h2 class="text-center my-4">{{ product.title }}</h2>

        <div class="d-flex justify-content-between mb-5">
            <div>
                <img src="{{ asset('uploads/images/' ~ product.picture) }}" alt="{{ product.title }}">
            </div>

            <div class="ml-3">
                <div class="d-flex justify-content-around">
                <p><strong>Référence: </strong>{{ product.reference }}</p>
                <p><strong>Catégorie: </strong>{{ product.category.title }}</p>
                </div>

                <div class="d-flex justify-content-evenly">
                    <p><strong>Couleur: </strong>{{ product.color }}</p>
                    <p><strong>Mémoire: </strong>{{ product.size }}</p>
                    <p><strong>Genre: </strong>{{ product.gender }}</p>
                </div>
                
                <div>
                    <p><strong>Description: </strong>{{ product.description }}</p>
                    <p class="fs-4"><strong>{{ product.price }}€</strong></p>
                </div>


                {% if product.stock == 0 %}
                    <p class="text-danger">Désolé, cet article n'est plus en stock</p>
                {% else %}
                    {% if product.stock < 10 %}
                        <p class="text-warning">Attention, il n'en reste que {{ product.stock }} en stock</p>
                    {% endif %}
                    <div class="mb-4">
                        <select name="quantity" id="quantity">
                        {% if product.stock < 10 %}
                            {% for i in 1.. product.stock %}
                                <option value="{{ i }}">{{ i }}</option>
                            {% endfor %}
                        {% else %}
                            {% for i in 1..10 %}
                                <option value="{{ i }}">{{ i }}</option>
                            {% endfor %}
                        {% endif %}
                        </select>
                        <button class="btn btn-dark p-1">Ajouter au panier</button>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}