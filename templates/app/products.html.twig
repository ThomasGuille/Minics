{% extends 'base.html.twig' %}

{% block title %}
    Minics | Boutique
{% endblock %}

{% block body %}

    <section class="product_section layout_padding">
    <div class="container">
      <div class="heading_container heading_center">
        <h2>
          Nos articles
        </h2>
      </div>
      <div class="row">
        {% for item in dbProducts %}
          <div class="col-sm-6 col-lg-4">
            <div class="box">
              <div class="img-box">
                <img src="{{ asset('uploads/images/' ~ item.picture) }}" alt="{{ item.title }}">
                <a href="{{ path('app_product_details', {'id': item.id}) }}" class="add_cart_btn">
                  <span>
                    En savoir plus
                  </span>
                </a>
              </div>
              <div class="detail-box">
                <a href="{{ path('app_product_details', {'id': item.id}) }}">
                  <h5 class="text-black">
                    {{ item.title }}
                  </h5>
                  <div class="product_info">
                    <h5 class="text-black">
                      <span class="text-black">{{ item.price }}</span>€
                    </h5>
                    <div class="star_container">
                      <i class="fa fa-star" aria-hidden="true"></i>
                      <i class="fa fa-star" aria-hidden="true"></i>
                      <i class="fa fa-star" aria-hidden="true"></i>
                      <i class="fa fa-star" aria-hidden="true"></i>
                      <i class="fa fa-star" aria-hidden="true"></i>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

{% endblock %}