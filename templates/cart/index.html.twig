{% extends 'base.html.twig' %}

{% block title %} Minics | Votre panier {% endblock %}

{% block body %}

<div class="container my-5">
    {% for label, messages in app.flashes(["success", "danger", "warning"]) %}
        {% for message in messages %}
            <div class="bg-{{ label }} text-white p-3 mb-3">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}
    <table class="table table-borderless">
        <thead>
            <tr>
                <th>Photo</th>
                <th>Titre</th>
                <th>Référence</th>
                <th>Catégorie</th>
                <th>Quantité</th>
                <th>Prix unitaire</th>
                <th>Prix total</th>
                <th>Retirer</th>
            </tr>
        </thead>
        <tbody>
            {% if dataCart is empty %}
                <tr>
                    <td colspan="7" class="text-center">Aucun article dans le panier</td>
                </tr>
            {% else %}
                {% for item in dataCart %}
                    {# {{ dump(item) }} #}
                    <tr>
                        <td><img class="product__picture" src="{{ asset('uploads/images/' ~ item.product.picture) }}" alt="{{ item.product.title }}"></td>
                        <td>{{ item.product.title }}</td>
                        <td>{{ item.product.reference }}</td>
                        <td>{{ item.product.category.title }}</td>
                        <td>
                            {% if item.quantity > 1 %}
                                <a href="{{ path('app_cart_remove_quantity', {'id': item.product.id}) }}"><span class="btn btn-dark p-1">-</span></a>
                            {% else %}
                                <a><span class="btn btn-secondary p-1">-</span></a>
                            {% endif %}
                             {{ item.quantity }} <a href="{{ path('app_cart_add_quantity', {'id': item.product.id}) }}"><span class="btn btn-dark p-1">+</span></a></td>
                        <td>{{ item.product.price }}€</td>
                        <td>{{ item.product.price * item.quantity }}€</td>
                        <td><button type="button" class="btn btn-danger"><i class="fa-solid fa-trash" data-bs-toggle="modal" data-bs-target="#product-{{ item.product.id }}"></i></button></td>
                    </tr>
                    
                    <div class="modal fade" id="product-{{ item.product.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="exampleModalLabel">Confirmation suppression</h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Voulez vous réellement retirer l'article <strong>{{ item.product.title }}</strong> du panier?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                <a href="{{ path('app_cart_remove_product', {'id': item.product.id}) }}" type="button" class="btn btn-primary">Confirmer</a>
                            </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td><strong>Total du panier: </strong></td>
                    <td>{{ total }}€</td>
                </tr>
            {% endif %}
        </tbody>
    </table>
    {% if dataCart is not empty %}
        {% if app.user %}
            <a class="btn btn-dark mr-2" href="{{ path('app_cart_payment') }}">Valider le panier</a>
            <button type="button" class="btn btn-danger" href="" data-bs-toggle="modal" data-bs-target="#cart-modal-delete">Vider le panier</button>
            <div class="modal fade" id="cart-modal-delete" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="exampleModalLabel">Confirmation suppression</h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Voulez vous vraiment vider entièrement le panier?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                <a href="{{ path('app_cart_delete') }}" type="button" class="btn btn-primary">Confirmer</a>
                            </div>
                            </div>
                        </div>
                    </div>
        {% else %}
            <a class="btn btn-dark" href="{{ path('app_login') }}">Identifiez vous pour continuer</a>
        {% endif %}
    {% endif %}
</div>

{% endblock %}
